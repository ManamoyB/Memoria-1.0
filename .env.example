# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# MemoriaOS Document Reader Agent Configuration
# ==============================================================================
MEMORIA_APP_NAME="MemoriaOS"
MEMORIA_APP_VERSION="1.0.0"
MEMORIA_ENVIRONMENT="development"
MEMORIA_DEBUG=false
MEMORIA_LOG_LEVEL="INFO"

# Server (Render injects PORT automatically at runtime)
MEMORIA_HOST="127.0.0.1"
PORT=8000
MEMORIA_API_PREFIX="/api/v1"
MEMORIA_REQUEST_TIMEOUT_SECONDS=300.0
MEMORIA_CORS_ORIGINS="https://your-frontend.example.com,http://localhost:3000"

# Storage & Upload Limits (leave unset to use ephemeral OS /tmp directory)
# MEMORIA_UPLOAD_DIR="/tmp/memoria_uploads"
MEMORIA_MAX_FILE_SIZE_MB=25
MEMORIA_MAX_BATCH_FILES=10
MEMORIA_CLEANUP_TEMP_UPLOADS=true

# Extraction, Chunking & Future OCR (Tesseract)
MEMORIA_DEFAULT_ENCODING="utf-8"
MEMORIA_ALLOWED_FORMATS="pdf,docx,txt,markdown,csv"
MEMORIA_CSV_MAX_ROWS=10000
MEMORIA_CHUNK_SIZE=3000
MEMORIA_CHUNK_OVERLAP=300
MEMORIA_PDF_MIN_TEXT_CHARS_PER_PAGE=40
MEMORIA_OCR_ENABLED=false
MEMORIA_OCR_ENGINE="tesseract"
MEMORIA_TESSERACT_CMD="tesseract"
MEMORIA_TESSERACT_LANG="eng"

# Structured memory. setup.ps1 replaces the password placeholder with random local credentials.
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MEMORIA_DATABASE_URL=postgresql+psycopg://memoria:CHANGE_ME_DATABASE_PASSWORD@localhost:5432/memoria
MEMORIA_OWNER_ID=local-owner
MEMORIA_OLLAMA_BASE_URL=http://localhost:11434
MEMORIA_OLLAMA_MODEL=qwen2.5-coder:7b
# Set to 0 for CPU-only generation if GPU memory is insufficient.
MEMORIA_OLLAMA_NUM_GPU=-1
MEMORIA_OLLAMA_CONTEXT_LENGTH=4096
MEMORIA_EMBEDDING_MODEL=nomic-embed-text
MEMORIA_EMBEDDING_DIMENSIONS=768
MEMORIA_QDRANT_URL=http://localhost:6333
MEMORIA_QDRANT_COLLECTION=memoria_nomic_768_v1
MEMORIA_PROVIDER_TIMEOUT=120
MEMORIA_OBSIDIAN_ENABLED=false
# Existing vault only. Enable export after inspecting the configuration.
MEMORIA_OBSIDIAN_VAULT_PATH=D:\AI\SecondBrain\CareerBrain\MemoriaOS-Vault
MEMORIA_RATE_LIMIT_PER_MINUTE=120

